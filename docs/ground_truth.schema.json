{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SmartArchive-X page ground truth gt-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "source_sha256", "page", "text_path", "text_sha256", "is_blank", "reading_order", "transcriber", "review"],
  "properties": {
    "schema_version": {"const": "gt-v1"},
    "document_id": {"type": "string", "pattern": "\\S"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "page": {"type": "integer", "minimum": 1},
    "text_path": {"type": "string", "pattern": "\\S"},
    "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "is_blank": {"type": "boolean"},
    "reading_order": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "\\S"}
    },
    "transcriber": {"type": "string", "pattern": "\\S"},
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reviewer", "reviewed_at"],
      "properties": {
        "status": {"enum": ["draft", "reviewed", "approved"]},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"]}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "draft"}}},
        "then": {"properties": {"reviewer": {"type": "null"}, "reviewed_at": {"type": "null"}}},
        "else": {"properties": {
          "reviewer": {"type": "string", "pattern": "\\S"},
          "reviewed_at": {"type": "string", "format": "date-time"}
        }}
      }]
    }
  },
  "$comment": "Runtime also checks source/page association, actual byte hashes, distinct reviewer/transcriber, timezone, transcript encoding and blank-page consistency. No external JSON Schema library is required."
}
