# Backend: variables are read from the environment, not automatically from this file.
SMARTARCHIVE_STORAGE_DIR=./storage
SMARTARCHIVE_MAX_UPLOAD_MB=32
SMARTARCHIVE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# OCR (optional): models folder from tools/fetch_ocr_models.py and the language set to use.
# Best on the synthetic development corpus (ADR 0008): script/Arabic+ara at 200 dpi (all Arabic-Indic digits).
# SMARTARCHIVE_TESSDATA_DIR=./models/tessdata
# SMARTARCHIVE_OCR_LANGUAGES=script/Arabic+ara
# SMARTARCHIVE_OCR_DPI=200
